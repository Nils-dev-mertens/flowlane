{
  "name": "flowlane",
  "version": "0.2.30",
  "description": "Agile board to pull request workflow automation — Ticket → Branch → PR",
  "main": "dist/index.js",
  "bin": {
    "flowlane": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "build:watch": "tsc --watch",
    "test": "node --require ts-node/register --test tests/run.ts",
    "dev": "ts-node src/index.ts",
    "local": "npm run build && npm i -g .",
    "start": "node dist/index.js",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cli",
    "agile",
    "devops",
    "kanban",
    "workflow",
    "developer-tools"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "azure-devops-node-api": "^12.5.0",
    "chalk": "^4.1.2",
    "commander": "^12.0.0",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.8.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
