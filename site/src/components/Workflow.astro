---
import Terminal from './Terminal.astro';

const steps = [
  {
    n: '01',
    icon: 'play_arrow',
    color: 'text-primary',
    title: 'Start',
    command: 'flowlane start 14',
    body: 'Pulls the ticket, generates a slug branch name, creates it, and pushes to origin — before you even open an editor.',
    meta: '→ 14-implement-landingpage',
  },
  {
    n: '02',
    icon: 'code_blocks',
    color: 'text-secondary',
    title: 'Ship',
    command: 'flowlane pr 14',
    body: 'Opens a pull request with the ticket link attached. Draft, reviewers, and labels all from flags.',
    meta: '→ PR #42 · draft',
  },
  {
    n: '03',
    icon: 'rate_review',
    color: 'text-tertiary',
    title: 'Review',
    command: 'flowlane pr review',
    body: 'One repeatable session for review threads, files, inline comments, and votes — no tab hunting.',
    meta: '→ 4 threads · 2 votes',
  },
  {
    n: '04',
    icon: 'merge',
    color: 'text-primary',
    title: 'Merge',
    command: 'flowlane pr complete',
    body: 'Merges with your chosen strategy and moves the ticket across the board automatically.',
    meta: '→ 14 moved to Done',
  },
];
---

<section class="py-32 bg-surface-container-low px-6 md:px-8 border-y border-outline-variant/5" id="workflow">
  <div class="max-w-7xl mx-auto">
    <div class="mb-20 text-center md:text-left" data-reveal>
      <p class="text-[10px] font-mono uppercase tracking-widest opacity-40 mb-4">The Complete Loop</p>
      <h2 class="text-5xl md:text-7xl font-black font-headline uppercase tracking-tighter leading-none">
        ONE COMMAND. <span class="text-primary">WHOLE</span> FLOW.
      </h2>
      <p class="mt-6 max-w-2xl text-on-surface-variant text-lg md:text-left mx-auto md:mx-0">
        From ticket to merged PR — and the board updated — without opening a browser once. Every step is
        one short command, and the terminal remembers the context.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8" data-reveal-group>
      {
        steps.map((step) => (
          <div class="relative bg-surface p-8 border border-outline-variant/10 flex flex-col gap-5 group">
            <div class="flex items-start justify-between">
              <span class:list={['material-symbols-outlined text-3xl', step.color]} style="font-variation-settings: 'FILL' 1;">
                {step.icon}
              </span>
              <span class="text-[10px] font-mono uppercase tracking-widest opacity-30">{step.n}</span>
            </div>
            <div>
              <h3 class="text-lg font-bold font-headline uppercase mb-2">{step.title}</h3>
              <code class="term-line block text-secondary text-xs mb-3">{step.command}</code>
              <p class="text-sm text-on-surface-variant leading-relaxed">{step.body}</p>
            </div>
            <div class="mt-auto pt-4 border-t border-outline-variant/10 text-[10px] font-mono uppercase tracking-wider opacity-50 group-hover:text-primary transition-colors">
              {step.meta}
            </div>
          </div>
        ))
      }
    </div>

    <div class="mt-16 grid lg:grid-cols-2 gap-8 items-stretch">
      <div class="bg-surface-container-high p-10 border border-outline-variant/10 flex flex-col justify-center" data-reveal>
        <span class="material-symbols-outlined text-4xl text-primary mb-6" style="font-variation-settings: 'FILL' 1;">counter_0</span>
        <p class="text-xl md:text-2xl font-bold font-headline uppercase tracking-tight leading-tight">
          ZERO CONTEXT SWITCHES.<br />
          <span class="text-primary">FOUR TERMINAL LINES.</span>
        </p>
        <p class="mt-6 text-on-surface-variant leading-relaxed">
          Ticket → branch → PR → merge. flowlane infers the ticket from the branch you're on, so the PR
          command doesn't even need an ID. The whole loop fits in the muscle memory of your home row.
        </p>
      </div>

      <Terminal title="flowlane" frameClass="border border-outline-variant/20">
        <div class="text-tertiary-fixed-dim">
          <span class="opacity-50">$ </span><span data-type="flowlane start 14"></span><span class="inline-block w-2 h-4 bg-primary align-middle ml-1"></span>
        </div>
        <div class="mt-4 space-y-1.5">
          <div class="text-on-surface-variant">◇ Branch created &amp; pushed: 14-implement-landingpage</div>
          <div class="text-on-surface-variant">◇ Ticket 14 moved to In Progress</div>
        </div>
        <div class="mt-5 border-t border-outline-variant/10 pt-4 space-y-1.5">
          <div class="text-tertiary-fixed-dim">$ flowlane pr 14</div>
          <div class="text-primary">✓ PR #42 opened — draft, link to 14 attached</div>
        </div>
        <div class="mt-5 border-t border-outline-variant/10 pt-4 space-y-1.5">
          <div class="text-tertiary-fixed-dim">$ flowlane pr complete 42</div>
          <div class="text-primary">✓ Merged — 14 moved to Done</div>
        </div>
        <div class="mt-5 border-t border-outline-variant/10 pt-4 text-tertiary-fixed-dim">
          Session: ticket to merged PR in 3 commands · 0 browser tabs
        </div>
      </Terminal>
    </div>
  </div>
</section>