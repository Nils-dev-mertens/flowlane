---
import Terminal from './Terminal.astro';

const cards = [
  {
    icon: 'account_tree',
    color: 'text-secondary',
    title: 'Profiles',
    body: 'One config, many contexts. flowlane profile add / use / remove keeps separate credentials per organisation or project.',
  },
  {
    icon: 'folder_copy',
    color: 'text-tertiary',
    title: 'Repo Overrides',
    body: 'Drop a .flowlane file in a repository to override the global profile for that repo only — different base branch, different profile.',
  },
  {
    icon: 'tune',
    color: 'text-primary',
    title: 'Every Setting',
    body: 'flowlane config set baseBranch develop — statuses, board columns, endpoints, auth method. Flat keys or dotted provider keys.',
  },
  {
    icon: 'bolt',
    color: 'text-secondary',
    title: 'Post-Action Hooks',
    body: 'Run shell commands after actions: open the PR, post to Slack, launch VS Code. hookAfterPR: open {{prUrl}}.',
  },
];
---

<section class="py-48 px-6 md:px-8 max-w-7xl mx-auto" id="configure">
  <div class="mb-24 text-center md:text-left" data-reveal>
    <h2 class="text-5xl md:text-7xl font-black font-headline uppercase tracking-tighter mb-4">
      MAKE IT <span class="text-primary">YOURS</span>
    </h2>
    <p class="text-on-surface-variant tracking-widest text-xs uppercase font-bold">Configure · Override · Automate</p>
  </div>

  <div class="grid lg:grid-cols-2 gap-16 items-start">
    <div class="grid sm:grid-cols-2 gap-8" data-reveal-group>
      {
        cards.map((card) => (
          <div class="bg-surface-container p-8 border border-outline-variant/10 flex flex-col gap-6">
            <span class:list={['material-symbols-outlined text-3xl', card.color]}>{card.icon}</span>
            <div>
              <h3 class="text-xl font-bold font-headline mb-3 uppercase">{card.title}</h3>
              <p class="text-sm text-on-surface-variant leading-relaxed">{card.body}</p>
            </div>
          </div>
        ))
      }
    </div>

    <Terminal title="~/.config/flowlane/config.json" frameClass="lg:sticky lg:top-24" data-reveal data-reveal-delay="0.15">
      <div data-reveal-group>
        <div class="text-on-surface-variant">$ flowlane config list --json</div>
        <pre class="mt-4 text-secondary-fixed-dim leading-relaxed overflow-x-auto">{`{
  "activeProfile": "work",
  "profiles": {
    "work": {
      "ticketProvider": "jira",
      "vcsProvider": "github",
      "jira": {
        "site": "acme.atlassian.net",
        "project": "PRJ",
        "token": "***"
      },
      "github": {
        "owner": "Nils-dev-mertens",
        "repo": "flowlane",
        "user": "janedoe",
        "baseBranch": "main"
      },
      "hookAfterPR": "open {{prUrl}}"
    }
  }
}`}</pre>
        <div class="inline-block w-2 h-4 bg-primary"></div>
      </div>
    </Terminal>
  </div>
</section>
