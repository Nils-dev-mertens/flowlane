---
import Terminal from './Terminal.astro';
---

<section class="py-32 bg-surface-container-low px-6 md:px-8 border-y border-outline-variant/5" id="story">
  <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-20 items-center">
    <div class="space-y-8">
      <h2 class="text-4xl md:text-6xl font-bold font-headline leading-none uppercase tracking-tighter">
        STOP <span class="text-primary">CONTEXT</span> SWITCHING.
      </h2>
      <div class="space-y-6 text-on-surface-variant text-lg leading-relaxed">
        <p>
          You're in the flow. The code is writing itself. Then you need a ticket ID — you alt-tab, Chrome opens,
          and forty-seven tabs scream for attention. You find the ticket, but wait — someone just replied on Slack.
        </p>
        <p class="border-l-4 border-primary pl-6 py-2 italic font-medium bg-primary/5">
          "The modern developer workflow is a minefield of distractions disguised as tools."
        </p>
        <p>
          flowlane is for the developer tired of the "browser dance" — and for the agile team that lives in
          Azure DevOps, GitHub, or Jira. Link tickets, create branches, and push PRs without ever lifting your
          hands from the home row.
        </p>
      </div>
    </div>

    <Terminal title="flowlane" frameClass="aspect-square p-10 md:p-12">
      <div class="flex flex-col justify-between h-full gap-8">
        <div class="flex justify-between items-start">
          <span class="text-[8px] font-mono opacity-30">SYS_DEBUG_091.2</span>
          <span class="material-symbols-outlined text-primary text-xl">architecture</span>
        </div>
        <div class="space-y-2">
          <div class="h-1 w-1/2 bg-outline-variant/40"></div>
          <div class="h-1 w-3/4 bg-outline-variant/20"></div>
          <div class="h-1 w-1/4 bg-primary/40"></div>
        </div>
        <div class="text-[10px] font-mono text-secondary-fixed-dim leading-tight">
          DETECTING_WORKFLOW_BLOAT...<br />
          PURGING_BROWSER_DEPENDENCY...<br />
          <span class="text-primary font-bold">STATUS: TERMINAL_FOCUSED</span>
        </div>
      </div>
    </Terminal>
  </div>
</section>
