---
import Command from './Command.astro';
import Terminal from './Terminal.astro';

const steps = [
  {
    n: '01',
    title: 'Install',
    body: 'One global install. Requires Node.js 18+ and git on your PATH.',
  },
  {
    n: '02',
    title: 'Initialize',
    body: 'flowlane init runs an interactive wizard — pick your platform, organisation, project, and identity.',
  },
  {
    n: '03',
    title: 'Flow',
    body: 'flowlane tickets to browse, flowlane start to begin, flowlane pr to open the pull request.',
  },
];

const prereqs = ['Node.js 18+', 'git on PATH', 'Azure DevOps PAT (or az-cli)', 'GitHub token — optional for reads'];
---

<section class="py-48 px-6 md:px-8 max-w-7xl mx-auto" id="install">
  <div class="mb-24 text-center md:text-left" data-reveal>
    <h2 class="text-5xl md:text-7xl font-black font-headline uppercase tracking-tighter mb-4">
      FLOWING IN <span class="text-primary">THREE STEPS</span>
    </h2>
    <p class="text-on-surface-variant tracking-widest text-xs uppercase font-bold">Install · Initialize · Flow</p>
  </div>

  <div class="grid lg:grid-cols-2 gap-16 items-start">
    <div class="space-y-6" data-reveal>
      <Command command="npm install -g flowlane" />
      <Command command="flowlane init" />

      <div class="grid sm:grid-cols-3 gap-0 border-t border-outline-variant/10 mt-12">
        {
          steps.map((step, i) => (
            <div class:list={['p-6 text-left', i < 2 ? 'sm:border-r border-outline-variant/10' : '']}>
              <span class="text-xs font-bold text-primary font-headline tracking-widest uppercase mb-4 block">{step.n}</span>
              <h3 class="text-sm font-bold font-headline uppercase mb-2">{step.title}</h3>
              <p class="text-xs text-on-surface-variant leading-relaxed">{step.body}</p>
            </div>
          ))
        }
      </div>

      <div>
        <p class="text-[10px] font-mono uppercase tracking-widest opacity-40 mb-3">Prerequisites</p>
        <div class="flex flex-wrap gap-2">
          {
            prereqs.map((item) => (
              <span class="px-2 py-1 bg-secondary-container/20 text-secondary text-[10px] font-mono uppercase tracking-wider">
                {item}
              </span>
            ))
          }
        </div>
      </div>
    </div>

    <Terminal title="flowlane init" frameClass="lg:sticky lg:top-24" data-reveal data-reveal-delay="0.15">
      <div class="text-tertiary-fixed-dim">$ flowlane init</div>
      <div class="mt-4 space-y-3">
        <div>
          <div class="text-on-surface-variant">◇ Select your ticket provider</div>
          <div class="pl-4 text-primary">› Azure DevOps · GitHub · Jira</div>
        </div>
        <div>
          <div class="text-on-surface-variant">◇ Select your PR provider</div>
          <div class="pl-4 text-primary">› GitHub</div>
        </div>
        <div>
          <div class="text-on-surface-variant">◇ Organisation</div>
          <div class="pl-4 text-primary">› Nils-dev-mertens</div>
        </div>
        <div>
          <div class="text-on-surface-variant">◇ Token</div>
          <div class="pl-4 text-on-surface-variant">••••••••••••</div>
        </div>
        <div class="text-tertiary-fixed-dim">✓ Profile "work" saved to ~/.config/flowlane/config.json</div>
      </div>
      <div class="animate-pulse inline-block w-2 h-4 bg-primary"></div>
    </Terminal>
  </div>
</section>
