---
const cards = [
  {
    icon: 'lock',
    color: 'text-primary',
    title: 'Stored Locally',
    body: 'PATs live in your own config at ~/.config/flowlane/config.json and are sent only to the provider API you configured. No account, no relay, no cloud.',
  },
  {
    icon: 'shield',
    color: 'text-secondary',
    title: 'Owner-Only File',
    body: 'On Unix the config file is locked to owner-only permissions (chmod 600), so nothing else on the machine can read your stored tokens.',
  },
  {
    icon: 'key',
    color: 'text-tertiary',
    title: 'CLI Auth Option',
    body: 'Prefer not to store a token? Use gh or az CLI auth — flowlane fetches a fresh token on every call and never writes it to disk.',
  },
  {
    icon: 'visibility_off',
    color: 'text-primary',
    title: 'Masked Everywhere',
    body: 'Every token value prints as *** — in flowlane config output, saved profile notes, and any command echo. The secret never hits your screen.',
  },
];
---

<section class="py-48 px-6 md:px-8 max-w-7xl mx-auto" id="security">
  <div class="mb-24 text-center md:text-left" data-reveal>
    <p class="text-[10px] font-mono uppercase tracking-widest opacity-40 mb-4">Credentials &amp; Trust</p>
    <h2 class="text-5xl md:text-7xl font-black font-headline uppercase tracking-tighter mb-4">
      AUTH, <span class="text-primary">LOCKED DOWN</span>
    </h2>
    <p class="text-on-surface-variant tracking-widest text-xs uppercase font-bold">Local · Owner-Only · Masked · No Relay</p>
  </div>

  <div class="grid sm:grid-cols-2 gap-8" data-reveal-group>
    {
      cards.map((card) => (
        <div class="bg-surface-container p-10 border border-outline-variant/10 flex flex-col gap-6">
          <span class:list={['material-symbols-outlined text-3xl', card.color]} style="font-variation-settings: 'FILL' 1;">
            {card.icon}
          </span>
          <div>
            <h3 class="text-xl font-bold font-headline mb-3 uppercase">{card.title}</h3>
            <p class="text-sm text-on-surface-variant leading-relaxed">{card.body}</p>
          </div>
        </div>
      ))
    }
  </div>

  <p class="mt-12 text-center text-on-surface-variant font-mono text-xs opacity-60" data-reveal>
    No telemetry · No analytics · Tokens never leave your machine except to the provider you configured.
  </p>
</section>