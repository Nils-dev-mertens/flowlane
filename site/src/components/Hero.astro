---
import Command from './Command.astro';
---

<section class="relative min-h-screen flex flex-col items-center justify-center pt-32 pb-24 px-6 md:px-8 text-center overflow-hidden">
  <!-- Decorative rotated frames -->
  <div class="absolute top-0 left-0 w-full h-full opacity-10 pointer-events-none" aria-hidden="true">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] border border-outline-variant/30 rotate-45"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[1200px] h-[1200px] border border-outline-variant/10 -rotate-12"></div>
  </div>

  <h1 class="text-[clamp(4rem,15vw,12rem)] font-black tracking-tighter leading-none mb-4 font-headline uppercase">
    FLOWLANE
  </h1>

  <p class="max-w-2xl text-on-surface-variant font-medium tracking-tight mb-12 text-lg md:text-xl">
    The high-velocity CLI for engineers who refuse to leave the terminal.
    <span class="text-primary italic">Automate the architecture of your workflow.</span>
  </p>

  <div class="flex flex-col md:flex-row items-center gap-6 w-full max-w-3xl">
    <Command command="npm install -g flowlane" />
    <a
      href="#install"
      class="w-full md:w-auto whitespace-nowrap bg-primary-container text-on-primary-container px-10 py-5 font-black uppercase tracking-widest text-sm hover:bg-primary transition-colors"
    >
      Initialize Flow
    </a>
  </div>

  <!-- Hero stats -->
  <div class="mt-24 grid grid-cols-1 md:grid-cols-3 w-full max-w-6xl border-t border-outline-variant/10">
    <div class="p-8 text-left border-b md:border-b-0 md:border-r border-outline-variant/10">
      <span class="text-xs font-bold text-primary font-headline tracking-widest uppercase mb-4 block">01 / Speed</span>
      <p class="text-sm text-on-surface-variant leading-relaxed">
        Instant command execution without browser overhead. Tickets, branches, and PRs — handled from the home row.
      </p>
    </div>
    <div class="p-8 text-left border-b md:border-b-0 md:border-r border-outline-variant/10">
      <span class="text-xs font-bold text-primary font-headline tracking-widest uppercase mb-4 block">02 / Open Source</span>
      <p class="text-sm text-on-surface-variant leading-relaxed">
        Built by devs, for devs. MIT licensed and free forever — no enterprise gates on core productivity features.
      </p>
    </div>
    <div class="p-8 text-left">
      <span class="text-xs font-bold text-primary font-headline tracking-widest uppercase mb-4 block">03 / Universal</span>
      <p class="text-sm text-on-surface-variant leading-relaxed">
        One tool for Azure DevOps, GitHub, and Jira. Mix ticket and PR providers freely — Jira tickets with GitHub PRs.
      </p>
    </div>
  </div>
</section>
