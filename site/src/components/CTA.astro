---
import pkg from '../../../package.json';
---

<section class="py-48 px-6 md:px-8 text-center bg-surface relative overflow-hidden">
  <div class="absolute inset-0 grid-bg opacity-30" aria-hidden="true"></div>
  <div class="relative z-10 max-w-4xl mx-auto">
    <span class="text-primary font-black uppercase tracking-[0.3em] text-sm mb-6 block">Ready for Precision?</span>
    <h2 class="text-6xl md:text-8xl font-black font-headline uppercase tracking-tighter mb-12 leading-none">
      JOIN THE <span class="italic">FLOW</span>
    </h2>
    <div class="flex flex-col md:flex-row justify-center gap-6 items-center">
      <a
        href="#install"
        class="bg-primary-container text-on-primary-container px-12 py-6 font-black uppercase tracking-[0.2em] text-lg hover:bg-primary transition-all"
      >
        Get Started Now
      </a>
      <a
        href="https://github.com/Nils-dev-mertens/flowlane#readme"
        target="_blank"
        rel="noreferrer"
        class="text-on-surface border border-outline-variant/40 px-12 py-6 font-black uppercase tracking-[0.2em] text-lg hover:bg-surface-container-high transition-all"
      >
        Read Docs
      </a>
    </div>
    <p class="mt-12 text-on-surface-variant font-mono text-xs opacity-60">
      v{pkg.version} | Compatible with macOS, Linux, Windows · Node 18+
    </p>
  </div>
</section>
