---
const links = [
  { href: '#story', label: 'Story' },
  { href: '#workflow', label: 'Workflow' },
  { href: '#features', label: 'Features' },
  { href: '#integrations', label: 'Integrations' },
  { href: '#install', label: 'Install' },
  { href: '#commands', label: 'Commands' },
  { href: '#community', label: 'Community' },
];
---

<header class="fixed top-0 w-full z-50 bg-[#15121a]/80 backdrop-blur-xl">
  <div class="flex justify-between items-center px-6 md:px-8 py-4">
    <a href="#top" class="text-2xl font-bold tracking-tighter text-[#ffb4aa] font-headline uppercase">
      FLOWLANE
    </a>

    <nav class="hidden md:flex items-center space-x-8 xl:space-x-10">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="text-[#e7e0ec] hover:text-[#ffb4aa] transition-colors duration-200 font-headline uppercase tracking-tight text-xs"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-4">
      <a
        href="#install"
        class="hidden sm:block bg-primary-container text-on-primary-container px-6 py-2 text-xs font-bold font-headline uppercase tracking-widest active:scale-95 transition-transform"
      >
        Get Started
      </a>
      <button
        type="button"
        id="nav-toggle"
        class="md:hidden p-2 text-on-surface hover:text-primary transition-colors"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="nav-menu"
      >
        <span id="nav-toggle-icon" class="material-symbols-outlined">menu</span>
      </button>
    </div>
  </div>

  <div
    id="nav-menu"
    class="md:hidden overflow-hidden max-h-0 transition-[max-height] duration-300 bg-surface-container-low border-t border-outline-variant/10"
  >
    <nav class="px-6 py-4 flex flex-col gap-4">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="text-[#e7e0ec] hover:text-[#ffb4aa] transition-colors font-headline uppercase tracking-tight text-sm py-2"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="#install"
        class="bg-primary-container text-on-primary-container px-6 py-3 text-xs font-bold font-headline uppercase tracking-widest text-center"
      >
        Get Started
      </a>
    </nav>
  </div>
</header>

<script is:inline>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-menu');
  const icon = document.getElementById('nav-toggle-icon');
  const closeMenu = () => {
    menu.classList.add('max-h-0');
    menu.classList.remove('max-h-96');
    toggle.setAttribute('aria-expanded', 'false');
    icon.textContent = 'menu';
  };
  if (toggle && menu && icon) {
    toggle.addEventListener('click', () => {
      const opening = menu.classList.contains('max-h-0');
      menu.classList.toggle('max-h-0', !opening);
      menu.classList.toggle('max-h-96', opening);
      toggle.setAttribute('aria-expanded', String(opening));
      icon.textContent = opening ? 'close' : 'menu';
    });
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeMenu));
  }
</script>