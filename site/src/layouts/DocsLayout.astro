---
import '../styles/global.css';
import pkg from '../../../package.json';

interface Props {
  title?: string;
  description?: string;
  /** Pre-rendered markdown HTML (pages that render repo .md files). */
  html?: string;
  /** Current page href, used to highlight the active nav item. */
  current?: string;
  /** Path of the source file in the repo, e.g. "INSTALL.md". */
  source?: string;
}

const {
  title = 'Documentation — flowlane',
  description = 'flowlane CLI documentation: install, configuration, providers, and command reference.',
  html,
  current = '',
  source,
} = Astro.props;

const docLinks = [
  { href: '/docs', label: 'Overview' },
  { href: '/docs/install', label: 'Install' },
  { href: '/docs/adding-a-provider', label: 'Add a Provider' },
  { href: '/docs/reference', label: 'Reference' },
  { href: '/license', label: 'License' },
];

const isActive = (href: string) => href === current;

const toc = html
  ? [...html.matchAll(/<h([23]) id="([^"]+)"[^>]*>(.*?)<\/h\1>/g)].map((m) => ({
      level: Number(m[1]),
      id: m[2],
      text: m[3].replace(/<[^>]+>/g, ''),
    }))
  : [];

const order = ['/docs', '/docs/install', '/docs/adding-a-provider', '/docs/reference', '/license'];
const idx = order.indexOf(current);
const prev = idx > 0 ? order[idx - 1] : null;
const next = idx >= 0 && idx < order.length - 1 ? order[idx + 1] : null;
const labelOf = (href: string) => docLinks.find((l) => l.href === href)?.label ?? href;
const editUrl = source ? `https://github.com/Nils-dev-mertens/flowlane/edit/main/${source}` : null;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#15121a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="selection:bg-primary-container selection:text-on-primary-container">
    <header class="fixed top-0 w-full z-50 bg-[#15121a]/80 backdrop-blur-xl">
      <div class="flex justify-between items-center px-6 md:px-8 py-4">
        <a href="/" class="text-xl font-bold tracking-tighter text-[#ffb4aa] font-headline uppercase">
          FLOWLANE
          <span class="text-[#e7e0ec]/50 text-xs font-normal normal-case">/ docs</span>
          <span class="ml-2 px-1.5 py-0.5 bg-secondary-container/20 text-secondary text-[9px] font-mono uppercase tracking-wider">
            v{pkg.version}
          </span>
        </a>
        <nav class="hidden md:flex items-center space-x-7 xl:space-x-9">
          {
            docLinks.map((link) => (
              <a
                href={link.href}
                class:list={[
                  'font-headline uppercase tracking-tight text-xs transition-colors duration-200',
                  isActive(link.href)
                    ? 'text-[#ffb4aa] border-b-2 border-[#ffb4aa] pb-1'
                    : 'text-[#e7e0ec] hover:text-[#ffb4aa]',
                ]}
              >
                {link.label}
              </a>
            ))
          }
        </nav>
        <a
          href="/#install"
          class="bg-primary-container text-on-primary-container px-5 py-2 text-xs font-bold font-headline uppercase tracking-widest active:scale-95 transition-transform"
        >
          Get Started
        </a>
      </div>

      <nav class="lg:hidden overflow-x-auto px-6 pb-3 flex gap-6 border-b border-outline-variant/10">
        {
          docLinks.map((link) => (
            <a
              href={link.href}
              class:list={[
                'font-headline uppercase tracking-tight text-xs whitespace-nowrap transition-colors',
                isActive(link.href) ? 'text-[#ffb4aa]' : 'text-[#e7e0ec] hover:text-[#ffb4aa]',
              ]}
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </header>

    <main class="pt-28 pb-24 px-6 md:px-8">
      <div class="max-w-6xl mx-auto grid lg:grid-cols-[220px_minmax(0,1fr)] gap-12 items-start">
        <aside class="hidden lg:block lg:sticky lg:top-28 space-y-10">
          <nav>
            <p class="text-[10px] font-mono uppercase tracking-widest opacity-40 mb-4">Documentation</p>
            <div class="flex flex-col gap-2">
              {
                docLinks.map((link) => (
                  <a
                    href={link.href}
                    class:list={[
                      'font-headline uppercase tracking-tight text-xs py-1 border-l-2 pl-3 transition-colors',
                      isActive(link.href)
                        ? 'border-[#ff5545] text-[#ffb4aa]'
                        : 'border-outline-variant/20 text-on-surface-variant hover:text-[#ffb4aa] hover:border-primary/50',
                    ]}
                  >
                    {link.label}
                  </a>
                ))
              }
            </div>
          </nav>

          {
            toc.length > 0 && (
              <nav data-toc>
                <p class="text-[10px] font-mono uppercase tracking-widest opacity-40 mb-4">On this page</p>
                <div class="flex flex-col gap-1.5">
                  {
                    toc.map((t) => (
                      <a
                        href={`#${t.id}`}
                        class:list={[
                          'text-xs leading-snug transition-colors hover:text-[#ffb4aa]',
                          t.level === 3 ? 'pl-4 text-[#e7e0ec]/60' : 'text-on-surface-variant',
                        ]}
                      >
                        {t.text}
                      </a>
                    ))
                  }
                </div>
              </nav>
            )
          }
        </aside>

        <article class="markdown min-w-0 max-w-3xl">
          {html ? <Fragment set:html={html} /> : <slot />}

          {
            editUrl && (
              <p class="mt-16 text-[10px] font-mono uppercase tracking-widest opacity-40">
                <a href={editUrl} target="_blank" rel="noreferrer" class="hover:text-[#ffb4aa] transition-colors">
                  Edit this page on GitHub ↗
                </a>
              </p>
            )
          }

          {
            (prev || next) && (
              <nav class="mt-8 pt-8 border-t border-outline-variant/10 flex justify-between gap-6">
                {prev ? (
                  <a href={prev} class="group text-left">
                    <span class="block text-[10px] font-mono uppercase tracking-widest opacity-40 mb-1">← Prev</span>
                    <span class="font-headline uppercase text-sm group-hover:text-[#ffb4aa] transition-colors">{labelOf(prev)}</span>
                  </a>
                ) : (
                  <span />
                )}
                {next ? (
                  <a href={next} class="group text-right">
                    <span class="block text-[10px] font-mono uppercase tracking-widest opacity-40 mb-1">Next →</span>
                    <span class="font-headline uppercase text-sm group-hover:text-[#ffb4aa] transition-colors">{labelOf(next)}</span>
                  </a>
                ) : (
                  <span />
                )}
              </nav>
            )
          }
        </article>
      </div>
    </main>

    <footer class="w-full py-10 px-6 md:px-8 flex flex-col md:flex-row justify-between items-center gap-6 bg-surface-container-low">
      <div>
        <div class="text-lg font-black text-[#ffb4aa] font-headline uppercase tracking-tight mb-2">FLOWLANE</div>
        <p class="text-[#e7e0ec]/60 font-headline text-[10px] tracking-widest uppercase">© docs · MIT</p>
      </div>
      <div class="flex flex-wrap gap-7 justify-center">
        {
          docLinks.map((link) => (
            <a
              href={link.href}
              class="font-headline text-xs tracking-widest uppercase text-[#e7e0ec]/60 hover:text-[#ffb4aa] underline underline-offset-4 transition-colors"
            >
              {link.label}
            </a>
          ))
        }
        <a
          href="https://github.com/Nils-dev-mertens/flowlane"
          target="_blank"
          rel="noreferrer"
          class="font-headline text-xs tracking-widest uppercase text-[#e7e0ec]/60 hover:text-[#ffb4aa] underline underline-offset-4 transition-colors"
        >
          GitHub
        </a>
        <a
          href="https://www.npmjs.com/package/flowlane"
          target="_blank"
          rel="noreferrer"
          class="font-headline text-xs tracking-widest uppercase text-[#e7e0ec]/60 hover:text-[#ffb4aa] underline underline-offset-4 transition-colors"
        >
          npm
        </a>
      </div>
    </footer>

    <script>
      // Copy buttons for every code block.
      document.querySelectorAll('.markdown pre').forEach((pre) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'copy-docs';
        btn.setAttribute('aria-label', 'Copy code to clipboard');
        btn.innerHTML = '<span class="material-symbols-outlined text-sm">content_copy</span>';
        pre.appendChild(btn);
        btn.addEventListener('click', () => {
          const text = pre.querySelector('code')?.innerText ?? '';
          navigator.clipboard?.writeText(text).catch(() => {});
          const icon = btn.querySelector('.material-symbols-outlined');
          if (icon) {
            icon.textContent = 'check';
            setTimeout(() => {
              icon.textContent = 'content_copy';
            }, 1500);
          }
        });
      });

      // Scrollspy for the "On this page" table of contents.
      const tocLinks = Array.from(document.querySelectorAll('[data-toc] a'));
      if (tocLinks.length && 'IntersectionObserver' in window) {
        const map = tocLinks.map((a) => ({ link: a, heading: document.getElementById(a.getAttribute('href').slice(1)) }));
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                map.forEach(({ link, heading }) => {
                  link.classList.toggle('toc-active', heading === entry.target);
                });
              }
            }
          },
          { rootMargin: '-96px 0px -70% 0px' }
        );
        map.forEach(({ heading }) => heading && io.observe(heading));
      }
    </script>
  </body>
</html>